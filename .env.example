# ── Vercel AI Gateway (single provider for all LLMs) ────────────────
# Get a key at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
# On Vercel deployments OIDC is used automatically if no key is set.
AI_GATEWAY_API_KEY=

# Optional: direct OpenAI fallback for embeddings/memory (if not using gateway)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# MongoDB (matches docker-compose.yml)
MONGODB_URI=mongodb://127.0.0.1:27017/feastedchat

# Qdrant (matches docker-compose.yml)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Embedding model for RAG (via AI Gateway)
# Examples: openai/text-embedding-3-small (1536 dims), openai/text-embedding-3-large (3072), cohere/embed-v4.0 (1536)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=1536

# ── Mem0 Memory Layer (via Gateway) ───────────────────────────────────
MEM0_LLM_MODEL=gpt-4o-mini
MEM0_EMBEDDER_MODEL=text-embedding-3-small
MEM0_EMBEDDER_DIMS=1536
