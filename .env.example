# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# MongoDB (matches docker-compose.yml)
MONGODB_URI=mongodb://127.0.0.1:27017/feastedchat

# Qdrant (matches docker-compose.yml)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Embedding model for RAG (via AI Gateway)
EMBEDDING_MODEL=voyage/voyage-4

# Ollama (shared by RAG embeddings and Mem0)
OLLAMA_BASE_URL=http://localhost:11434

# Mem0 Memory Layer (LLM provider: 'ollama' or 'gateway')
MEM0_LLM_PROVIDER=ollama
MEM0_LLM_MODEL=qwen3:4b
